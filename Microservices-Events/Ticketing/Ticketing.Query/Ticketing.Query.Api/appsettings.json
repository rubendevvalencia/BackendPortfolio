{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": 
  {
    "PostgresConnection":""
  },
  "AllowedHosts": "*",
  "ConsumerConfig":
  {
    // Grupo de consumidores: Kafka guarda los offsets leídos por grupo
    "GroupId":"TK_CONSUMER",
    // Dirección del broker de Kafka (listener externo del compose)
    "BootstrapServers": "localhost:29092",
    // false: el offset se confirma a mano con Commit, tras procesar el evento
    "EnableAutoCommit": false,
    // Earliest: si el grupo no tiene offset guardado, lee desde el principio del topic
    "AutoOffsetReset": "Earliest",
    // false: el consumidor no crea topics; si no existe, falla al suscribirse
    "AllowAutoCreateTopics": false
  }
}
