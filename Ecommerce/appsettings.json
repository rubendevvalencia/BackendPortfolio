{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // La clave se declara vacia a proposito: este archivo define la FORMA de la configuracion,
  // no sus valores. El valor real llega de User Secrets en desarrollo
  //   dotnet user-secrets set "ConnectionStrings:EcommerceDb" "<cadena>" --project Ecommerce
  // o de una variable de entorno en despliegue (ConnectionStrings__EcommerceDb).
  "ConnectionStrings": {
    "EcommerceDb": ""
  },
  "Config": {
    "OrinCors": "https://localhost:3000"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Ecommerce",
    "Audience": "Ecommerce.Users"
  }
}
