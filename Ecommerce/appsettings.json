{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Las claves sensibles se declaran vacias a proposito: este archivo define la FORMA de la
  // configuracion, no sus valores. Los valores reales llegan de User Secrets en desarrollo
  //   dotnet user-secrets set "ConnectionStrings:EcommerceDb" "<cadena>" --project Ecommerce
  //   dotnet user-secrets set "Jwt:Key" "<clave base64 de 32 bytes o mas>" --project Ecommerce
  // o de variables de entorno en despliegue (ConnectionStrings__EcommerceDb, Jwt__Key).
  "ConnectionStrings": {
    "EcommerceDb": ""
  },
  "Config": {
    "OrinCors": "https://localhost:3000"
  },
  // Issuer y Audience NO son secretos: viajan dentro del propio token y cualquiera que lo
  // reciba los ve. Solo la Key firma, y por eso es la unica que sale del control de versiones.
  "Jwt": {
    "Key": "",
    "Issuer": "Ecommerce",
    "Audience": "Ecommerce.Users"
  },
  "HealthChecksUI": {
    "EvaluationTimeInSeconds": 5,
    "HealthChecks": [
      {
        "Name": "Health Checks API",
        "Uri": "/health"
      }
    ]
  },
  "RateLimiting": {
    "PermitLimit": 4,
    "Window": 30,
    "QueueLimit": 0
  },
}
