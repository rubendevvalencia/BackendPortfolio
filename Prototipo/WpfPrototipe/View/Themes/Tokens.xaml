<!-- Espejo de tokens.json del Design System "Registro Perf" (tema claro). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Color -->
	<Color x:Key="SurfaceColor">#F6F7F9</Color>
	<Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
	<Color x:Key="LineColor">#D9DEE5</Color>
	<Color x:Key="InkColor">#16202C</Color>
	<Color x:Key="InkMutedColor">#5A6573</Color>
	<Color x:Key="AccentColor">#0F6CBD</Color>
	<Color x:Key="AccentHoverColor">#0B5596</Color>
	<Color x:Key="AccentInkColor">#FFFFFF</Color>
	<Color x:Key="SuccessColor">#166B2E</Color>
	<Color x:Key="SuccessSoftColor">#E3F4E8</Color>
	<Color x:Key="DangerColor">#C62828</Color>
	<Color x:Key="DangerSoftColor">#FCE8E8</Color>

	<SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
	<SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
	<SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
	<SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
	<SolidColorBrush x:Key="InkMuted" Color="{StaticResource InkMutedColor}" />
	<SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
	<SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
	<SolidColorBrush x:Key="AccentInk" Color="{StaticResource AccentInkColor}" />
	<SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
	<SolidColorBrush x:Key="SuccessSoft" Color="{StaticResource SuccessSoftColor}" />
	<SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
	<SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}" />

	<!-- Tipografía -->
	<FontFamily x:Key="FontSans">Segoe UI</FontFamily>
	<FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>

	<!-- Espaciado (space-1..6) -->
	<Thickness x:Key="Space2">8</Thickness>
	<Thickness x:Key="Space4">16</Thickness>
	<Thickness x:Key="Space6">24</Thickness>
	<Thickness x:Key="FieldGap">0,0,0,12</Thickness>

	<!-- Radios -->
	<CornerRadius x:Key="RadiusSm">2</CornerRadius>
	<CornerRadius x:Key="RadiusMd">4</CornerRadius>
	<CornerRadius x:Key="RadiusLg">8</CornerRadius>
</ResourceDictionary>
