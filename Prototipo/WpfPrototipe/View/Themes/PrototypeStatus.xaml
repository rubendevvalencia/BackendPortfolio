<Window x:Class="RegistroPerf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F6F7F9" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Etiqueta encima de cada campo -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A6573" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Campos: mismo aspecto para TextBox y PasswordBox -->
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#D9DEE5" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Field}" />
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Margin="24" Padding="16" Background="White"
            BorderBrush="#D9DEE5" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Datos de registro" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBlock Text="Nombre completo" Style="{StaticResource Label}" />
            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Email" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Contraseña (mín. 8, letras y números)" Style="{StaticResource Label}" />
            <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />

            <TextBlock Text="Repeticiones (1–100)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Repetitions, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" HorizontalAlignment="Left" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="Registrar" Command="{Binding RegisterCommand}" IsDefault="True"
                        Background="#0F6CBD" Foreground="White" BorderBrush="#0F6CBD" />
                <Button Grid.Column="2" Content="Cancelar" Command="{Binding RegisterCancelCommand}" />
            </Grid>

            <!-- Resultado: de momento solo un texto -->
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="#5A6573" />
        </StackPanel>
    </Border>
</Window>
