<Window x:Class="RegistroPerf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro" Width="780" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        FontFamily="{StaticResource FontSans}" FontSize="13">

    <!-- Los estilos (Card, Section, Label, campos y botones) vienen de Themes/Controls.xaml vía App.xaml. -->
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

    <Border x:Name="cardSingUp" Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="Sign Up" Style="{StaticResource Section}" />
            <TextBlock Text="User Name" Style="{StaticResource Label}" />
            <TextBox x:Name="tbUserName" TextChanged="tbUserName_TextChanged" />

            <TextBlock Text="Full Name" Style="{StaticResource Label}" />
            <TextBox x:Name="tbFullName" TextChanged="tbFullName_TextChanged" />
            <TextBlock Text="Email" Style="{StaticResource Label}" />
            <TextBox x:Name="EmailInput" TextChanged="EmailInput_TextChanged"/>
            
            <TextBlock Text="Password (mín. 8)" Style="{StaticResource Label}" />
            <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="Register" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Button_Click" />
                <Button Grid.Column="2" Content="Cancelar"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>
        </StackPanel>
    </Border>

    <Border x:Name="cardSignIn" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="Sign In" Style="{StaticResource Section}" />
            <TextBlock Text="Email" Style="{StaticResource Label}" />
            <TextBox x:Name="tbSignInUserName" TextChanged="tbSignInUserName_TextChanged" />

            <TextBlock Text="Password" Style="{StaticResource Label}" />
            <PasswordBox x:Name="SignInPasswordInput" PasswordChanged="SignInPasswordInput_PasswordChanged" />
            
            <Button x:Name="button_signIn" Content="Sign In" Margin="0,8,0,0"
                    Style="{StaticResource PrimaryButton}" Click="button_signIn_Click" />
                <TextBox x:Name="tbToken" IsReadOnly="True" TextWrapping="Wrap"
         BorderThickness="0" Background="Transparent"
         Padding="0" />

            </StackPanel>
    </Border>
    </Grid>
</Window>
