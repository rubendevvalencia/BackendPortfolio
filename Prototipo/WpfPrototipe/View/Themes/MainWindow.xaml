<Window x:Class="RegistroPerf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        FontFamily="{StaticResource FontSans}" FontSize="13">

    <!-- Los estilos (Card, Section, Label, campos y botones) vienen de Themes/Controls.xaml vía App.xaml. -->
    <Border Margin="24" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="Datos de registro" Style="{StaticResource Section}" />
            <TextBlock Text="Nombre completo" Style="{StaticResource Label}" />
            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Email" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Contraseña (mín. 8, letras y números)" Style="{StaticResource Label}" />
            <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />

            <TextBlock Text="Repeticiones (1–100)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Repetitions, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" HorizontalAlignment="Left" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="Registrar" Command="{Binding RegisterCommand}" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Button_Click" />
                <Button Grid.Column="2" Content="Cancelar" Command="{Binding RegisterCancelCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>

            <!-- Resultado: de momento solo un texto -->
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{StaticResource InkMuted}" />
        </StackPanel>
    </Border>
</Window>
