# ---------------------------------------------------------------
# .gitignore para soluciones .NET / Visual Studio
# Regla general: se versiona el codigo fuente y la configuracion,
# nunca el resultado de compilar ni el estado local del IDE.
# ---------------------------------------------------------------

# Resultado de la compilacion
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Estado local de Visual Studio (incluye CopilotSnapshots, FileContentIndex, ProjectEvaluation)
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Rider / VS Code
.idea/
*.sln.iml
.vscode/

# Resultados de tests y cobertura
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
*.trx

# Paquetes NuGet restaurados
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# Secretos y configuracion local
# appsettings.json SI se versiona: define la FORMA de la configuracion.
# Los VALORES reales van en User Secrets (desarrollo) o variables de entorno (despliegue).
appsettings.*.local.json
secrets.json
.env
*.pubxml
*.pubxml.user
PublishProfiles/
*.pfx
*.publishsettings

# Ficheros del sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Varios
*.tmp
*.cache
*.dbmdl
Monolito/docs/patrones-y-arquitectura-entrevista.md
